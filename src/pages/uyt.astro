---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Calculator" pageTitle="UYT Calculator" activePage="UYT Calculator">
  <section id="uyt-calculator">
    <h2>UYT (U Yield T) Calculator</h2>
    <p>Calculate U multiplied by Y and divided by T</p>
    <div id="uyt-inputs">
      <input type="number" id="input-u" placeholder="Value (U)" />
      <span id="multiply-symbol">×</span>
      <input type="number" id="input-y" placeholder="Multiplier (Y)" />
      <span id="divide-symbol">÷</span>
      <input type="number" id="input-t" placeholder="Divisor (T)" />
    </div>
    <div id="uyt-actions">
      <button type="button" id="btn-calculate">Calculate</button>
      <button type="button" id="btn-clear">Clear</button>
    </div>
  </section>
  <section id="results">
    <h2 id="current-calculation">0</h2>
    <h2>Result: <span id="current-result">0</span></h2>
  </section>
</BaseLayout>

<style>
  #uyt-calculator {
    margin: 2rem auto;
    width: 40rem;
    max-width: 90%;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 2rem;
    color: var(--color-primary);
    text-align: center;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base);
  }

  #uyt-calculator:hover {
    box-shadow: var(--shadow-lg);
  }

  #uyt-calculator h2 {
    margin-top: 0;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }

  #uyt-calculator p {
    font-size: 1.1rem;
    margin: 1rem 0;
  }

  #uyt-inputs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem 0;
    flex-wrap: wrap;
  }

  #uyt-inputs input {
    font: inherit;
    font-size: 1.5rem;
    border: 2px solid var(--color-primary);
    width: 6rem;
    padding: 0.5rem;
    color: var(--color-primary);
    text-align: center;
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast);
  }

  #uyt-inputs input:focus {
    outline: none;
    border-color: var(--color-primary-light);
    box-shadow: 0 0 0 3px rgba(2, 61, 109, 0.15);
  }

  #uyt-inputs input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #multiply-symbol,
  #divide-symbol {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--color-primary);
  }

  #uyt-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  #uyt-actions button {
    font: inherit;
    background: var(--color-primary);
    color: var(--color-white);
    border: 1px solid var(--color-primary);
    padding: 1rem 2rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
  }

  #uyt-actions button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #uyt-actions button:hover,
  #uyt-actions button:active {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  #btn-clear {
    background: var(--color-gray);
    border-color: var(--color-gray);
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
  }

  #btn-clear:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #btn-clear:hover,
  #btn-clear:active {
    background: var(--color-gray-dark);
    border-color: var(--color-gray-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
</style>

<script>
  const uInput = document.getElementById('input-u') as HTMLInputElement;
  const yInput = document.getElementById('input-y') as HTMLInputElement;
  const tInput = document.getElementById('input-t') as HTMLInputElement;
  const calculateBtn = document.getElementById('btn-calculate') as HTMLButtonElement;
  const clearBtn = document.getElementById('btn-clear') as HTMLButtonElement;
  const currentCalculation = document.getElementById('current-calculation') as HTMLElement;
  const currentResult = document.getElementById('current-result') as HTMLElement;

  let defaultResult: number = 0;
  let currentU: number = 0;
  let currentY: number = 0;
  let currentT: number = 0;

  function calculateUYT(u: number, y: number, t: number): number {
    if (t === 0) {
      throw new Error('Cannot divide by zero');
    }
    return (u * y) / t;
  }

  function updateCalculationDisplay(u: number, y: number, t: number, result: number): void {
    currentCalculation.textContent = `(${u} × ${y}) ÷ ${t}`;
    currentResult.textContent = String(result);
  }

  function handleCalculate(): void {
    const u = parseFloat(uInput.value);
    const y = parseFloat(yInput.value);
    const t = parseFloat(tInput.value);

    if (isNaN(u) || isNaN(y) || isNaN(t)) {
      alert('Please enter valid numbers for U, Y, and T.');
      return;
    }

    if (t === 0) {
      alert('Cannot divide by zero. Please enter a non-zero value for T.');
      return;
    }

    currentU = u;
    currentY = y;
    currentT = t;

    try {
      defaultResult = calculateUYT(u, y, t);
      updateCalculationDisplay(u, y, t, defaultResult);
    } catch (error) {
      alert((error as Error).message);
    }
  }

  function handleClear(): void {
    uInput.value = '';
    yInput.value = '';
    tInput.value = '';
    currentU = 0;
    currentY = 0;
    currentT = 0;
    defaultResult = 0;
    currentCalculation.textContent = '0';
    currentResult.textContent = '0';
  }

  calculateBtn.addEventListener('click', handleCalculate);
  clearBtn.addEventListener('click', handleClear);

  uInput.addEventListener('keypress', (event: KeyboardEvent) => {
    if (event.key === 'Enter') {
      handleCalculate();
    }
  });

  yInput.addEventListener('keypress', (event: KeyboardEvent) => {
    if (event.key === 'Enter') {
      handleCalculate();
    }
  });

  tInput.addEventListener('keypress', (event: KeyboardEvent) => {
    if (event.key === 'Enter') {
      handleCalculate();
    }
  });
</script>


