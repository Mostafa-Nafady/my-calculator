---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Welcome to My Calculator" pageTitle="Home" activePage="Home">
  <section id="home-content">
    <h2>Your Simple Web-Based Calculator</h2>
    <p>
      This calculator allows you to perform basic arithmetic operations including
      addition, subtraction, multiplication, and division.
    </p>
    <div id="home-actions">
      <a href="/calculator" id="btn-start">Start Calculating</a>
      <a href="/xpy" id="btn-xpy">XPY Calculator</a>
      <a href="/uyt" id="btn-uyt">UYT Calculator</a>
      <a href="/asd" id="btn-asd">ASD Calculator</a>
      <a href="/addop" id="btn-addop">ADDOP Calculator</a>
      <a href="/asdsfsf" id="btn-asdsfsf">ASDSFSF Calculator</a>
      <a href="/qwq" id="btn-qwq">QWQ Calculator</a>
    </div>
  </section>

  <section id="features">
    <h3>Features</h3>
    <ul>
      <li>Addition (+)</li>
      <li>Subtraction (-)</li>
      <li>Multiplication (*)</li>
      <li>Division (/)</li>
      <li>X Power Y (XPY)</li>
      <li>U Yield T (UYT)</li>
      <li>ASD Calculator</li>
      <li>ADDOP Calculator</li>
      <li>ASDSFSF Calculator</li>
      <li>QWQ Calculator</li>
    </ul>
  </section>
</BaseLayout>

<style>
  #home-content {
    margin: 2rem auto;
    width: 40rem;
    max-width: 90%;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 2rem;
    color: var(--color-primary);
    text-align: center;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base);
  }

  #home-content:hover {
    box-shadow: var(--shadow-lg);
  }

  #home-content h2 {
    margin-top: 0;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }

  #home-content p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 1.5rem 0;
  }

  #home-actions {
    margin-top: 2rem;
  }

  #btn-start {
    display: inline-block;
    font: inherit;
    background: var(--color-primary);
    color: var(--color-white);
    border: 1px solid var(--color-primary);
    padding: 1rem 2rem;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
  }

  #btn-start:hover,
  #btn-start:active {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  #btn-start:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #btn-xpy {
    display: inline-block;
    font: inherit;
    background: var(--color-xpy);
    color: var(--color-white);
    border: 1px solid var(--color-xpy);
    padding: 1rem 2rem;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
    margin-left: 1rem;
  }

  #btn-xpy:hover,
  #btn-xpy:active {
    background: var(--color-xpy-dark);
    border-color: var(--color-xpy-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  #btn-xpy:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #btn-uyt {
    display: inline-block;
    font: inherit;
    background: var(--color-uyt);
    color: var(--color-white);
    border: 1px solid var(--color-uyt);
    padding: 1rem 2rem;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
    margin-left: 1rem;
  }

  #btn-uyt:hover,
  #btn-uyt:active {
    background: var(--color-uyt-dark);
    border-color: var(--color-uyt-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  #btn-uyt:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #btn-asd {
    display: inline-block;
    font: inherit;
    background: var(--color-asd);
    color: var(--color-white);
    border: 1px solid var(--color-asd);
    padding: 1rem 2rem;
    cursor: pointer;
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-size: 1.1rem;
    font-weight: 700;
    transition: all var(--transition-fast);
    transform: translateY(0);
    margin-left: 1rem;
  }

  #btn-asd:hover,
  #btn-asd:active {
    background: var(--color-asd-dark);
    border-color: var(--color-asd-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  #btn-asd:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  #features {
    margin: 2rem auto;
    width: 40rem;
    max-width: 90%;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base);
  }

  #features:hover {
    box-shadow: var(--shadow-lg);
  }

  #features h3 {
    margin-top: 0;
    text-align: center;
    color: var(--color-primary);
  }

  #features ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  #features li {
    background: var(--color-bg);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-primary);
    font-weight: bold;
    transition: transform var(--transition-fast);
  }

  #features li:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
</style>

