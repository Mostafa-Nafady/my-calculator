# Environment Variables for my-calculator
# Copy this file to .env and fill in your actual values
#
# ⚠️  SECURITY NOTICE:
#    - NEVER commit .env files to version control
#    - NEVER share JWT_SECRET in code, issues, or PR descriptions
#    - Rotate this secret immediately if it is ever exposed
#    - Use: openssl rand -hex 32 to generate a cryptographically secure secret
#    - Minimum recommended length: 64 hex characters (32 bytes)

# Used for signing auth tokens (JWT/session).
# Generate a new secret with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here


