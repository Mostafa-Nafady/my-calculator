{
  "name": "my-calculator",
  "version": "1.0.0",
  "description": "Static calculator web application",
  "private": true,
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint --config .htmlhintrc '**/*.html'",
    "lint:css": "stylelint --config .stylelintrc.json '**/*.css'",
    "lint:js": "eslint --config eslint.config.js '**/*.js'",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "htmlhint": "^1.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}

